# En Streamlit Cloud: Advanced settings > Secrets. Nunca subas secrets.toml a GitHub.
APP_ENV = "production"
BUSINESS_NAME = "IMPORTADORA"
CURRENCY = "USD"
TIMEZONE = "America/El_Salvador"
DATABASE_URL = "postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require"
# Genera este valor con: python scripts/hash_password.py
ADMIN_PASSWORD_HASH = "REEMPLAZAR_POR_HASH_GENERADO"
# false: todo el catálogo requiere contraseña; true: catálogo público, administración privada.
PUBLIC_CATALOG = true
